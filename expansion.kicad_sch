	(text "Expansion pads"
		(exclude_from_sim no)
		(at 76.454 48.768 0)
		(effects
			(font
				(size 2.4892 2.4892)
				(thickness 0.4978)
				(bold yes)
			)
			(justify left)
		)
		(uuid "514aa255-82b0-4fdd-9cde-a3eae20decac")
	)
	(text "Expansion pads (top side, board edge): wire-solder pads, no connector fitted.\nFull peripherals named by function; loose pins named by pin (role set in firmware).\nPB7, PC2: 0 mA negative injection (DS8626 Table 47), keep wires short.\nPC14, PC15: power switch, 3 mA sink only, no source (DS8626 Table 7, note 3).\n\nAUX pads: AUX1 = PA2 (TIM2_CH3 / TIM5_CH3), AUX2 = PB7 (TIM4_CH2), AUX3 = PA10 (TIM1_CH3)\n220R series resistors, same as the motor outputs\nSignal and GND only: servo power comes from the PDB or BEC, not from the FC\n\nJ12: PA15 GPIO + current sense input (PC2, ADC123_IN12) with 0R series and DNP RC/divider footprints, values TBD (AN4073)."
		(exclude_from_sim no)
		(at 76.962 60.706 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "a2239d15-4743-46c0-8415-9edb4a25c3c4")
	)
