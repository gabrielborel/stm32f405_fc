	(text "Communication - ELRS and GPS"
		(exclude_from_sim no)
		(at 140.462 74.168 0)
		(effects
			(font
				(size 2.5 2.5)
				(thickness 0.5)
				(bold yes)
			)
		)
		(uuid "25cdf7d6-3ceb-4e92-9083-a86c1f8bab55")
	)
	(text "Notes:\n- Labels from the MCU point of view (ELRS_TX = MCU TX -> receiver RX)\n- J5/J6: JST GH 4-pin (provisional). Order: 1 GND, 2 +5V, 3 TX, 4 RX\n- ELRS and GPS powered from +5V (PDB), not from the 3V3 LDOs\n- USART3 (PB10/PB11) is a system bootloader interface (AN2606 Rev 70, Table 73)"
		(exclude_from_sim no)
		(at 109.22 87.884 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "4adf5903-e315-4aed-b2aa-97fe568d5df1")
	)
	(text "ELRS: USART3, PB10 TX / PB11 RX, AF7\nGPS: USART6, PC6 TX / PC7 RX, AF8"
		(exclude_from_sim no)
		(at 109.22 78.74 0)
		(effects
