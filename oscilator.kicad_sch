	(text "HSE OSCILLATOR (8 MHz)"
		(exclude_from_sim no)
		(at 126.746 49.784 0)
		(effects
			(font
				(size 2.5 2.5)
				(thickness 0.5)
				(bold yes)
			)
		)
		(uuid "0636235e-2047-4510-842d-dc77cb8a9322")
	)
	(text "HSE 8 MHz, crystal X32258MOB4SI (ESR 150 Ω)\nUSB PLL: M=4, N=168, Q=7 → 48 MHz\n\nLoad caps CL1, CL2: 15pF C0G 0402\nCL1·CL2/(CL1+CL2) = CL − Cs\nCL = 12pF (crystal load capacitance)\nCs ≈ 5pF (AN2867 sec. 3.3)"
		(exclude_from_sim no)
		(at 102.87 59.69 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "a7ef7914-5f18-4a86-a150-59e5a879e357")
	)
	(text "References: DS8626 (Tables 32, 36), AN2867 (sec. 3.3, 3.4, 7.1)"
		(exclude_from_sim no)
		(at 103.124 93.98 0)
		(effects
			(font
				(size 0.8 0.8)
				(thickness 0.1)
			)
			(justify left)
		)
		(uuid "b4cc43c2-81e5-4e00-8de3-b1fdb623f122")
	)
	(text "No external feedback resistor:\nthe F405 has an internal 200 kΩ R_F (DS8626 Table 32).\n\nCrystal as close as possible to OSC_IN/OSC_OUT,\nshort, symmetric traces.\n\nGrounded guard ring around crystal + caps,\nwith a dedicated local GND plane on the layer below,\ntied to the nearest MCU VSS.\n\nNo high-frequency signals near the oscillator.\nDo not tie the crystal's metal can to this local GND."
		(exclude_from_sim no)
		(at 102.87 79.756 0)
		(effects
			(font
				(size 1.3 1.3)
				(thickness 0.26)
				(bold yes)
			)
			(justify left)
		)
		(uuid "d3e9560a-e28d-45b7-a0c9-b04c75939b63")
	)
