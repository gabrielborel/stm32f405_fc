	(text "C24/C25 as close as possible to VDD (pin 4), 100nF closest.\n"
		(exclude_from_sim no)
		(at 202.184 57.912 0)
		(effects
			(font
				(size 1.27 1.27)
				(thickness 0.254)
				(bold yes)
			)
		)
		(uuid "0a5ea4a2-8ff9-432f-bdc3-d202746f7279")
	)
	(text "References: DS39724 (Typical Applications Circuit, Note 4,\nEN characteristics), DS8626 (Table 48)"
		(exclude_from_sim no)
		(at 14.986 33.528 0)
		(effects
			(font
				(size 0.8 0.8)
				(thickness 0.1)
			)
			(justify left)
		)
		(uuid "13590d9f-6ee1-4795-a69e-af6b66f8f5cc")
	)
	(text "10k pull-ups on CMD and DAT0-3 go to +3V3_SD, NOT +3V3:\nwith the card off, its pins must stay below VDD + 0.3V.\nAllowed range 10k-100k; 10k chosen for noise margin.\nCLK has no pull-up (always driven by the host).\n\nCard detect uses the socket switch (DET_A/DET_B), not DAT3/CD:\nthe DAT3 pull-up keeps it high with or without a card.\nSD_CD (PC13) is active low: card inserted = 0. R18 on +3V3.\n\nDecoupling values are common practice, not from a manual."
		(exclude_from_sim no)
		(at 171.704 45.72 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "1689774a-c986-471f-acd4-f422f32ffd2a")
	)
	(text "References: DS8626 (sec. 3.27, Tables 7, 9, 48, 88), RM0090 ch. 31,\nSD Physical Layer Simplified Spec v9.10 (Table 3-1),\nKingston SDCS2 (Tables 6-2, 6-5, 6-6), Molex SD-104031-001"
		(exclude_from_sim no)
		(at 171.45 73.66 0)
		(effects
			(font
				(size 0.8 0.8)
				(thickness 0.1)
			)
			(justify left)
		)
		(uuid "1d1afde4-03e4-448e-ab0e-93f9e7946a04")
	)
	(text "Dedicated LDO for the SD card: splits the heat from the main\nLDO and isolates the MCU rail from card inrush.\nEN driven by SD_EN (PC3). R15 holds EN low during reset:\nthe internal 3 MΩ pull-down is too weak against GPIO leakage.\nPulling EN low power-cycles the card (output discharged internally)."
		(exclude_from_sim no)
		(at 14.986 24.13 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "4e1a7d5e-7215-4ca6-9503-066d0e8caffe")
	)
	(text "C22 and C23 close to U6."
		(exclude_from_sim no)
		(at 27.686 30.988 0)
		(effects
			(font
				(size 1.27 1.27)
				(thickness 0.254)
				(bold yes)
			)
		)
		(uuid "5f2e58d6-7134-4403-8f6c-e51089e3d1c8")
	)
	(text "TPs on the trace itself, \nno stub (SDIO trace ≤ 20 pF, AN4488 Sec. 8.4.1)."
		(exclude_from_sim no)
		(at 172.466 123.19 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "79b9d25c-cd0d-4985-b0d6-ef4463b6e1b0")
	)
	(text "MICROSD CARD (SDIO 4-BIT)"
		(exclude_from_sim no)
		(at 199.39 33.02 0)
		(effects
			(font
				(size 2.5 2.5)
				(thickness 0.5)
				(bold yes)
			)
		)
		(uuid "a801ba3f-0b4f-4d71-94f4-692e9be2685c")
	)
	(text ">> FIRMWARE: init in 1-bit mode at low clock, then 4-bit (ACMD6)\n   and High-Speed (CMD6) before going above 25 MHz.\n   Disconnect the DAT3 internal pull-up (ACMD42).\n   Enable SD_EN only after SD_CD = 0; drive SDIO pins low\n   before turning the card off."
		(exclude_from_sim no)
		(at 171.958 66.04 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "ad3c5e6d-8e25-471f-8a0e-c32c63891aa5")
	)
	(text "MICROSD LDO (+3V3_SD)"
		(exclude_from_sim no)
		(at 38.608 16.51 0)
		(effects
			(font
				(size 2.5 2.5)
				(thickness 0.5)
				(bold yes)
			)
		)
		(uuid "c9add7e4-dd46-4f1b-be47-76690ac0adcb")
	)
