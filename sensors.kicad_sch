			)
		)
		(uuid "7d5029c6-683d-47f5-b6ea-9d28bcf5bb57")
	)
	(text "BAROMETER BMP581\n"
		(exclude_from_sim no)
		(at 77.216 36.322 0)
		(effects
			(font
				(size 2.5 2.5)
				(thickness 0.5)
				(bold yes)
			)
		)
		(uuid "856adb4e-6fdb-43f9-b638-cd89621821d3")
	)
	(text "Decoupling caps as close as possible to VDDIO and VDD\n\nPull-ups on SDA (SDI) and SCL (SCK) (provisional values)"
		(exclude_from_sim no)
		(at 57.912 65.024 0)
		(effects
			(font
				(size 1.3 1.3)
				(thickness 0.254)
				(bold yes)
			)
			(justify left)
		)
		(uuid "9dba07d0-b7e1-46a8-bda7-c6731212903f")
	)
	(text "References: BMP581 Datasheet (BST-BMP581-DS004) Rev 1.13,\nTable 28, Fig. 26 (Sec. 6.2.3), Sec. 5.6, Sec. 8.2 / Fig. 32 | DS8626 Rev 12, Table 7 (pins),\nSec. 6.3.16 and 6.3.19 (basis for the pull-up calculation)\nSec. 5.1 (interface selection)"
		(exclude_from_sim no)
		(at 58.166 70.866 0)
		(effects
			(font
				(size 0.8 0.8)
				(thickness 0.1)
			)
			(justify left)
		)
		(uuid "a7387ee2-4e41-4c6a-9e0e-e9317169b3d4")
	)
	(text "VDDIO and VDD from the regulated +3.3V\nSCL -> PB8 / SDA -> PB9\n\nCSB tied directly to VDDIO (I2C mode, BMP581 DS Sec. 6.2.3)\n\nSDO to GND: I2C address 0x46 (SDO high gives 0x47, DS Sec. 5.6)\n\nINT (pin 7) to PC14 as BMP_INT, test point TP16\n\nLanding pattern (DS Fig. 32): no vias, traces or\nsolder mask under the sensor"
		(exclude_from_sim no)
		(at 58.166 50.292 0)
		(effects
			(font
				(size 1.27 1.27)
				(thickness 0.1588)
			)
			(justify left)
		)
		(uuid "b27bbc13-d24e-45a0-9fbd-be89678a7e69")
	)
	(text "References: BMI270 Datasheet Rev 1.6 (Table 22, Sec. 6.3-6.4) | DS8626 Rev 12 (Table 9)"
		(exclude_from_sim no)
		(at 136.652 62.484 0)
		(effects
			(font
				(size 0.8 0.8)
				(thickness 0.1)
			)
			(justify left)
		)
		(uuid "f3811f14-158a-47f8-80fe-698d0b05337a")
	)
	(text "Accel + gyro: measures drone attitude in flight (most critical FC data).\nVDD/VDDIO on +3V3, 100nF decoupling (C21, C20).\n\nCSB is a plain GPIO, not hardware NSS\n(I2C→SPI switch requires toggling the edge manually at boot).\nSPI mode 0, up to 10 MHz.\n\nPA5 SCK | PA6 MISO | PA7 MOSI | PA4 CS | PA3 INT1 (EXTI3)\n\nASDx/ASCx unconnected (AUX/OIS unused), BMI270 DS Table 22 note **"
		(exclude_from_sim no)
		(at 136.398 49.022 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "ff3fceda-3205-4a45-b844-100df77d1dda")
	)
