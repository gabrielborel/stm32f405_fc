	(text "C21 and C20 as close as possible to pins 8 (VDD) and 5 (VDDIO)."
		(exclude_from_sim no)
		(at 136.398 60.452 0)
		(effects
			(font
				(size 1.3 1.3)
				(thickness 0.26)
				(bold yes)
			)
			(justify left)
		)
		(uuid "01872719-47b3-4cd0-a063-1ba73f8eecc9")
	)
	(text "IMU - BMI270 (SPI1)"
		(exclude_from_sim no)
		(at 156.718 36.322 0)
		(effects
			(font
				(size 2.5 2.5)
				(thickness 0.5)
