	(text "Não usar resistor de feedback externo,\no F405 já tem R_F interno de 200 kΩ (DS8626 Tabela 32)\n\nCristal o mais próximo possível dos pinos OSC_IN/OSC_OUT,\ntrilhas curtas e simétricas\n\nGuard ring aterrado ao redor do conjunto cristal e capacitores,\ncom plano de GND local dedicado na camada logo abaixo,\namarrado ao VSS mais próximo do MCU\n\nNenhum sinal de alta frequência passando perto do oscilador,\ne não ligar o encapsulamento metálico do cristal a esse GND local"
		(exclude_from_sim no)
		(at 38.862 178.562 0)
		(effects
			(font
				(size 1.3 1.3)
				(thickness 0.26)
				(bold yes)
			)
			(justify left)
		)
		(uuid "493a9fd4-9a07-46ee-b9b7-4730542d8a3b")
	)
