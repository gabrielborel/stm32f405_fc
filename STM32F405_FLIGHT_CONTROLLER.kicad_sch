	)
	(text "HSE 8 MHz com Cristal X32258MOB4SI (ESR 150 Ω)\nPLL do USB (M=4, N=168, Q=7 para 48 MHz)\n\nCapacitores de carga CL1 e CL2 15pF são C0G 0402\nFórmula CL1·CL2/(CL1+CL2) = CL − Cs\nCL = 12pF (valor de carga do cristal)\nCs ~= 5pF (ref. AN2867 seç. 3.3)\n\n"
		(exclude_from_sim no)
		(at 38.608 159.258 0)
		(effects
			(font
				(size 1.27 1.27)
