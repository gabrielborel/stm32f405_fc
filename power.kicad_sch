	(text "VOLTAGE DIVIDER"
		(exclude_from_sim no)
		(at 81.026 101.6 0)
		(effects
			(font
				(size 2.5 2.5)
				(thickness 0.5)
				(bold yes)
			)
		)
		(uuid "067d54a2-acd6-491d-9378-79bf5343ec20")
	)
	(text "References: AN4488 (sec. 2.2), DS8626 (Table 7, Figure 21/52)"
		(exclude_from_sim no)
		(at 156.972 131.064 0)
		(effects
			(font
				(size 0.8 0.8)
				(thickness 0.1)
			)
		)
		(uuid "17d19ae0-6113-473b-b942-bd430530889e")
	)
	(text "VDDA fed from the same 3V3 as VDD, filtered by a ferrite bead,\nwith two dedicated capacitors: 100nF ceramic + 1µF (tantalum or ceramic).\n(Ferrite bead ~100Ω @ 100MHz, low DCR)"
		(exclude_from_sim no)
		(at 137.16 121.158 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "2e0aacaf-24e2-4dc9-81be-841cb3da9d1f")
	)
	(text "Both capacitors as close as possible to the VDDA pin.\nFerrite bead between 3.3V and 3.3VA , upstream of the capacitors."
		(exclude_from_sim no)
		(at 136.906 128.016 0)
		(effects
			(font
				(size 1.3 1.3)
				(thickness 0.26)
				(bold yes)
			)
			(justify left)
		)
		(uuid "2e1912d8-975c-44a9-a34a-b5fbadf1c7b3")
	)
	(text "References: AP2112 Datasheet, Diodes Inc. (DS39724 Rev. 2-2)\nTypical Applications Circuit, Note 4, Pin Descriptions"
		(exclude_from_sim no)
		(at 156.718 72.644 0)
		(effects
			(font
				(size 0.8 0.8)
			)
			(justify left)
		)
		(uuid "315d3085-8ddf-487f-8336-913d39b4e7f9")
	)
	(text "5V POWER INPUT"
		(exclude_from_sim no)
		(at 84.836 48.26 0)
		(effects
			(font
				(size 2.5 2.5)
				(thickness 0.5)
				(bold yes)
			)
		)
		(uuid "447cd73c-59aa-4c33-a17d-6522f165d4ac")
	)
	(text "FC powered by the PDB over 4 wires:\nVBAT/+12V/GND/+5V\n\nBulk capacitor between +5V and GND:\n10uF ceramic X5R/X7R, 25V"
		(exclude_from_sim no)
		(at 69.088 55.626 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "706c18d7-4a9c-43e9-9d3b-a4d23feac58c")
	)
	(text "References: DS8626 (Table 67: VAIN, RAIN, note 5)"
		(exclude_from_sim no)
		(at 64.77 119.634 0)
		(effects
			(font
				(size 0.8 0.8)
			)
			(justify left)
		)
		(uuid "86739868-a521-40b5-8f18-7d9a73ed1944")
	)
	(text "FILTERING AND DECOUPLING (VDDA)"
		(exclude_from_sim no)
		(at 170.434 114.554 0)
		(effects
			(font
				(size 2.5 2.5)
				(thickness 0.5)
				(bold yes)
			)
		)
		(uuid "b5586213-9438-4547-a79b-4f0f1944d3ce")
	)
	(text "R3 and VBAT_SENSE as close as possible to the ADC pin.\nVBAT_SENSE → PC0 (ADC123_IN10)."
		(exclude_from_sim no)
		(at 64.516 116.84 0)
		(effects
			(font
				(size 1.3 1.3)
				(thickness 0.254)
				(bold yes)
			)
			(justify left)
		)
		(uuid "b5bc2253-f299-4f4f-8bb7-1f2e04e8c58c")
	)
	(text "Raw battery VBAT divided by R2 (100k) / R3 (10k), ratio 11×,\nto fit the ADC range (0 to 3V3).\nVBAT_SENSE goes to the ADC pin; firmware multiplies the reading by 11.\n(6S full: 25.2V → ~2.29V at the pin | max measurable: ~36.3V)\n\nSource impedance seen by the ADC: ~9.1kΩ (50kΩ limit)\nC across R3: RC low-pass, fc ≈ 175 Hz; low-impedance source for ADC sampling"
		(exclude_from_sim no)
		(at 64.77 108.966 0)
		(effects
			(font
				(size 1 1)
				(thickness 0.125)
			)
			(justify left)
		)
		(uuid "c260f107-696b-46d4-a90c-baa1fa2555db")
	)
	(text "PDB 5V comes from a switching converter (has ripple)"
		(exclude_from_sim no)
		(at 95.758 62.992 0)
		(effects
			(font
				(size 1.27 1.27)
				(thickness 0.254)
				(bold yes)
			)
		)
		(uuid "e5a52da5-62fb-4afa-be38-b96f5224ed3f")
	)
	(text "5V > 3.3V REGULATOR"
		(exclude_from_sim no)
		(at 177.8 46.228 0)
		(effects
			(font
				(size 2.5 2.5)
				(thickness 0.5)
				(bold yes)
			)
		)
		(uuid "f0fd594a-ef77-4d41-9c39-d4fe7f22fc67")
	)
	(text "AP2112K-3.3 regulates the PDB 5V down to 3V3,\nup to 600mA (min.).\n\nVIN and VOUT caps: 1µF each, X7R or X5R ceramic.\n\nEN must stay high (>1.5V) to keep the regulator\nalways on, so it's tied directly to VIN.\nNC pin (4) left unconnected.\n\nFeeds MCU and sensors only. The SD card has its own LDO\n   (+3V3_SD, Storage sheet)."
		(exclude_from_sim no)
		(at 156.464 59.436 0)
		(effects
			(font
				(size 1.27 1.27)
				(thickness 0.1588)
			)
			(justify left)
		)
		(uuid "f8ee8d39-7a3e-4c9f-9623-71b95185d48c")
	)
